[sub_resource type="GDScript" id="GDScript_s6ek7"]
script/source = "extends Control

var player
var itemScene
var item
var looped: bool = false
var itemChild: int = 0
var emptyItemScene: PackedScene = load(\"res://scenes/objects/empty_item.tscn\")
var emptyItem

func _ready() -> void:
	player = get_parent()

func _process(_delta: float) -> void:
	if $\"..\".visible and !looped:
		for i in GameManager.collectedItems:
			if GameManager.collectedItems[i][\"group\"] == \"item\":
				itemScene = load(GameManager.collectedItems[i][\"path\"])
				item = itemScene.instantiate()
				$Items/ItemParent.add_child(item)
				item.global_position = $Items/ItemParent.global_position
				item.scale = Vector2(0.6, 0.6)
				get_child(1).get_child(1).get_child(itemChild).get_child(1).hide()
				$Items/ItemCount.text = \"x\" + str(GameManager.collectedItems[i][\"amount\"])
				itemChild += 1
		looped = true
	
	if !$\"..\".visible and item:
			item.queue_free()
			itemChild = 0

	elif !$\"..\".visible: looped = false
	pass

#func render_item(Item: items):
	#pass
"

